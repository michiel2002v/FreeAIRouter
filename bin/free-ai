#!/usr/bin/env bash
# ==============================================================================
# free-ai: CLI companion for Free LLM APIs + OpenCode & LiteLLM Router
# Multi-user compatible: works for admin (michiel) and all system users
# ==============================================================================

# Source environment loader if present
for l in "$HOME/.local/bin/load-free-llms.sh" "/etc/profile.d/free-ai.sh" "/usr/local/share/free-ai/load-free-llms.sh" "$(dirname "$0")/load-free-llms.sh"; do
  if [ -f "$l" ]; then
    . "$l" 2>/dev/null
    break
  fi
done

# LiteLLM router proxy authorization key
export AUTO_FREE_API_KEY="${AUTO_FREE_API_KEY:-sk-free-llm}"

show_banner() {
  echo -e "\033[1;36m========================================================\033[0m"
  echo -e "\033[1;32m   🤖 Free LLM CLI — OpenCode & LiteLLM Router Hub      \033[0m"
  echo -e "\033[1;36m========================================================\033[0m"
}

cmd_status() {
  show_banner
  echo -e "\033[1;33mInstalled AI CLI:\033[0m"
  if command -v opencode >/dev/null 2>&1; then
    local oc_path=$(command -v opencode)
    local oc_ver=$(opencode --version 2>/dev/null || echo 'installed')
    echo -e "  ✓ \033[1mopencode\033[0m   $oc_ver ($oc_path)"
  else
    echo -e "  ✗ \033[31mopencode\033[0m   (not found in PATH)"
  fi

  echo ""
  echo -e "\033[1;33mOpen-Source Router Status (LiteLLM in Docker on :5111):\033[0m"
  local is_healthy=false
  if curl -sf http://127.0.0.1:5111/health/readiness >/dev/null 2>&1; then
    is_healthy=true
  fi

  if [ "$is_healthy" = true ]; then
    echo -e "  ✓ \033[1;32mRouter Active & Ready\033[0m (http://127.0.0.1:5111)"
    echo -e "    Default OpenCode model: \033[1;36mauto-free/free-coder\033[0m"
    echo -e "    Routing Strategy: \033[1;32mleast-busy (Multi-Session Parallel Distribution) + 3 Priority Tiers\033[0m"
    echo -e "    Multi-Session Support:  \033[1;32mActive\033[0m (Simultaneous sessions automatically balance across providers)"
    if docker ps --format '{{.Names}}' 2>/dev/null | grep -q "^free-llm-router$"; then
      echo -e "    Container: \033[1;36mfree-llm-router (running, restart: unless-stopped)\033[0m"
    fi
  else
    if docker ps --format '{{.Names}}' 2>/dev/null | grep -q "^free-llm-router$"; then
      echo -e "  · \033[33mContainer Running but Not Ready\033[0m"
    else
      echo -e "  · \033[33mContainer Not Running\033[0m (Run 'free-ai router start')"
    fi
  fi

  echo ""
  local has_keys=false
  for k in GROQ_API_KEY MISTRAL_API_KEY GEMINI_API_KEY NVIDIA_API_KEY COHERE_API_KEY KILO_API_KEY; do
    if [ -n "${!k}" ]; then
      has_keys=true
      break
    fi
  done

  if [ "$has_keys" = true ]; then
    echo -e "\033[1;33mConfigured Upstream Providers (from environment):\033[0m"
    check_p() {
      local var="$1"
      local name="$2"
      local desc="$3"
      if [ -n "${!var}" ]; then
        echo -e "  ✓ \033[1;32m$name\033[0m ($var) - $desc"
      else
        echo -e "  · \033[2m$name\033[0m ($var) - not set"
      fi
    }

    check_p "GROQ_API_KEY" "Groq" "Ultra-fast LPU inference (GPT-OSS 120B, Qwen 27B)"
    check_p "MISTRAL_API_KEY" "Mistral AI" "Codestral 256K, Mistral Small & Large"
    check_p "GEMINI_API_KEY" "Google Gemini" "1M+ context (Gemini 3.5 Flash-Lite, Pro)"
    check_p "KILO_API_KEY" "Kilo Code" "Reflection Beam & Cohere North Code"
    check_p "GONKA_API_KEY" "Gonka Broker" "DeepSeek V4 Flash 400K reasoning"
    check_p "NVIDIA_API_KEY" "NVIDIA NIM" "GPT-OSS 20B, Nemotron"
    check_p "COHERE_API_KEY" "Cohere" "Command R7B, Aya models"
    check_p "AION_API_KEY" "Aion Labs" "Aion 2.0 reasoning"
    check_p "ZAI_API_KEY" "Zhipu AI (Z AI)" "GLM-4.7-Flash series"
    check_p "REQUESTY_API_KEY" "Requesty" "Pennytree free reasoning"
    check_p "OPENROUTER_API_KEY" "OpenRouter" "Cohere North Mini Code & dynamic free router"
    check_p "CF_API_KEY" "Cloudflare Workers AI" "Llama 3.3 (requires CF_ACCOUNT_ID)"
  else
    echo -e "\033[1;33mShared Free-Tier Failover Engine:\033[0m"
    echo -e "  ✓ \033[1;32m18 High-Performance Models Configured\033[0m in LiteLLM Router Pool"
    echo -e "    All users share zero-cost access to Mistral Codestral, Gemini 3.8 Flash,"
    echo -e "    Groq 120B/Qwen 27B, Nemotron 550B, Command R+, DeepSeek V4, and more."
    echo -e "    (Centralized API keys managed securely by LiteLLM proxy on 127.0.0.1:5111)"
  fi

  echo ""
  echo -e "\033[1;33mQuick Commands:\033[0m"
  echo "  opencode                    Start OpenCode (uses LiteLLM auto-failover)"
  echo "  free-ai test                Verify live completions across all providers"
  echo "  free-ai last                Show the exact upstream model that handled your last prompt"
  echo "  free-ai watch               Stream real-time routing decisions as you code"
  echo "  free-ai summarize <file>    High-density technical summary via fast frontier model"
  echo "  free-ai router [status|logs|restart] Manage LiteLLM Docker container"
  echo "  free-ai opencode <model>    Start OpenCode with a specific model directly"
  echo ""
}

cmd_models() {
  show_banner
  echo -e "\033[1;33mRecommended models for your active providers:\033[0m"
  echo ""
  
  echo -e "\033[1;36m🔄 LiteLLM Auto-Router (Handles rate limits automatically):\033[0m"
  echo "  - auto-free/free-coder         (Failover: Mistral Codestral ➔ Gemini 3.8 Flash ➔ Groq 120B ➔ Cohere Command R+ ➔ Groq Qwen ➔ OpenRouter Nemotron ➔ Kilo ➔ Gonka ➔ NVIDIA ➔ Cohere ➔ Aion ➔ ZAI ➔ Requesty ➔ OpenRouter)"
  echo "  - openrouter/free              (OpenRouter's built-in free model dynamic router)"
  echo ""

  echo -e "\033[1;32m💻 Frontier & Dedicated Coding Models:\033[0m"
  echo "  - mistral/codestral-latest     (Specialized 256K FIM code model)"
  echo "  - gemini/gemini-3.8-flash      (Frontier Multimodal Reasoning, 1M context)"
  echo "  - groq/openai/gpt-oss-120b    (120B Frontier Reasoning ~200ms latency)"
  echo "  - groq/qwen/qwen3.8-27b        (Math & Algorithmic Code Reasoning)"
  echo "  - openrouter/nvidia/nemotron-3-ultra-550b-a55b:free (550B SOTA Reasoning)"
  echo "  - openrouter/cohere/north-mini-code:free (Dedicated 256K Code Model)"
  echo "  - kilo-auto/free              (Reflection Beam & Cohere North Code)"
  echo "  - gonka/deepseek-ai/DeepSeek-V4-Flash-0731 (400K context reasoning)"
  echo ""
  echo "Tip: Run 'opencode models' to list all models available to your session."
  echo "Tip: In OpenCode TUI, press F2 or type /model to switch on the fly."
  echo ""
}

cmd_test() {
  show_banner
  echo -e "\033[1;33m1. Live LiteLLM Router Health & Model Completion Test:\033[0m"
  if curl -sf http://127.0.0.1:5111/health/readiness >/dev/null 2>&1; then
    echo -e "  ✓ Router readiness check: \033[1;32mHEALTHY\033[0m (http://127.0.0.1:5111)"
    echo -e "  Testing live completion on model '\033[1;36mauto-free/free-coder\033[0m'..."
    local start_time
    start_time=$(python3 -c 'import time; print(int(time.time()*1000))')
    local resp
    resp=$(curl -sf -m 20 http://127.0.0.1:5111/v1/chat/completions \
      -H "Content-Type: application/json" \
      -H "Authorization: Bearer sk-free-llm" \
      -d '{"model":"auto-free/free-coder","messages":[{"role":"user","content":"Say hello in 3 words"}],"max_tokens":20}' 2>/dev/null || true)
    local end_time
    end_time=$(python3 -c 'import time; print(int(time.time()*1000))')
    local latency=$(( end_time - start_time ))

    if [ -n "$resp" ]; then
      local routed_model
      routed_model=$(echo "$resp" | python3 -c 'import sys, json; data=json.load(sys.stdin); print(data.get("model", "OK"))' 2>/dev/null || echo "OK")
      echo -e "  ✓ Completion Status: \033[1;32mPASS\033[0m (${latency}ms)"
      echo -e "  ✓ Upstream Route:    \033[1;32m$routed_model\033[0m"
    else
      echo -e "  ✗ Completion Status: \033[31mFAIL (timed out or error)\033[0m"
    fi
  else
    echo -e "  ✗ LiteLLM Router is not responding on http://127.0.0.1:5111"
  fi
  echo ""

  # Check if admin key verification script exists and keys are present
  local verify_script=""
  for p in "$HOME/.local/bin/verify-keys.js" "/usr/local/share/free-ai/verify-keys.js" "$(dirname "$0")/verify-keys.js" "/home/michiel/.local/bin/verify-keys.js"; do
    if [ -f "$p" ]; then
      verify_script="$p"
      break
    fi
  done

  if [ -n "$verify_script" ] && [ -n "$GROQ_API_KEY$MISTRAL_API_KEY$GEMINI_API_KEY" ]; then
    echo -e "\033[1;33m2. Direct Provider Key Verification:\033[0m"
    node "$verify_script"
  fi
}

cmd_router() {
  local compose_file=""
  for c in "$HOME/.config/litellm/docker-compose.yml" "/home/michiel/.config/litellm/docker-compose.yml" "/home/michiel/ai/docker-compose.yml"; do
    if [ -f "$c" ]; then
      compose_file="$c"
      break
    fi
  done

  case "${1:-status}" in
    status)
      if [ -n "$compose_file" ]; then
        docker compose -f "$compose_file" ps 2>/dev/null || docker ps --filter "name=free-llm-router"
      else
        docker ps --filter "name=free-llm-router"
      fi
      echo ""
      curl -s http://127.0.0.1:5111/health/readiness
      echo ""
      ;;
    restart)
      if [ -f "$HOME/.local/bin/start-router.sh" ]; then
        "$HOME/.local/bin/start-router.sh"
      elif docker ps --format '{{.Names}}' 2>/dev/null | grep -q "^free-llm-router$"; then
        echo "Restarting free-llm-router container..."
        docker restart free-llm-router
        echo "✓ Restarted free-llm-router container."
      elif [ -n "$compose_file" ]; then
        docker compose -f "$compose_file" restart
      fi
      ;;
    stop)
      if [ -n "$compose_file" ]; then
        docker compose -f "$compose_file" down
      else
        docker stop free-llm-router
      fi
      echo "LiteLLM Router stack stopped."
      ;;
    start|up)
      if [ -f "$HOME/.local/bin/start-router.sh" ]; then
        "$HOME/.local/bin/start-router.sh"
      elif [ -n "$compose_file" ]; then
        docker compose -f "$compose_file" up -d
      else
        docker start free-llm-router 2>/dev/null || echo "Cannot start container: compose file not found."
      fi
      ;;
    logs)
      if [ -n "$compose_file" ]; then
        docker compose -f "$compose_file" logs -n 50 "${@:2}" 2>/dev/null || docker logs -n 50 "${@:2}" free-llm-router
      else
        docker logs -n 50 "${@:2}" free-llm-router
      fi
      ;;
    *)
      echo "Usage: free-ai router [status|restart|stop|start|up|logs]"
      ;;
  esac
}

cmd_last() {
  local last_info
  last_info=$(docker exec free-llm-router cat /app/state/litellm_last_model.txt 2>/dev/null || docker exec free-llm-router cat /tmp/litellm_last_model.txt 2>/dev/null || true)
  if [ -n "$last_info" ]; then
    local model=$(echo "$last_info" | cut -d'|' -f1)
    local time=$(echo "$last_info" | cut -d'|' -f2)
    local latency=$(echo "$last_info" | cut -d'|' -f3)
    echo -e "🤖 \033[1;33mLast Routed Model:\033[0m \033[1;32m$model\033[0m"
    echo -e "   Response Latency: \033[1;36m$latency\033[0m"
    echo -e "   Completed At:     \033[1;36m$time\033[0m"

    local recent_logs
    recent_logs=$(docker exec free-llm-router tail -n 8 /app/state/recent_completions.log 2>/dev/null || true)
    if [ -n "$recent_logs" ]; then
      echo ""
      echo -e "⚡ \033[1;33mRecent Parallel Activity (Multi-Session In-Flight History):\033[0m"
      while IFS='|' read -r r_time r_model r_lat; do
        [ -z "$r_model" ] && continue
        printf "   • %-8s \033[1;36m%-40s\033[0m \033[2m(%s)\033[0m\n" "$r_time" "$r_model" "$r_lat"
      done <<< "$recent_logs"
    fi
  else
    echo "No requests routed yet since container start."
  fi
}

cmd_auto_heal() {
  show_banner
  echo -e "\033[1;33mAutonomous Model Self-Healing Watchdog:\033[0m"
  echo ""
  local heal_script=""
  for s in "$(dirname "$0")/auto-heal-llms.py" "$HOME/.local/bin/auto-heal-llms.py" "/usr/local/share/free-ai/auto-heal-llms.py" "/home/michiel/.local/bin/auto-heal-llms.py"; do
    if [ -f "$s" ]; then
      heal_script="$s"
      break
    fi
  done
  if [ -n "$heal_script" ]; then
    python3 "$heal_script" --verbose "$@"
  fi
  echo ""
  echo -e "\033[1;33mSystemd Watchdog Status:\033[0m"
  systemctl --user status auto-heal-llms.path auto-heal-llms.timer --no-pager 2>/dev/null | grep -E "●|Active|Trigger:" || true
  echo ""
}

cmd_summarize() {
  local sum_script=""
  for s in "$(dirname "$0")/summarize-context.py" "$HOME/.local/bin/summarize-context.py" "/usr/local/share/free-ai/summarize-context.py" "/home/michiel/.local/bin/summarize-context.py"; do
    if [ -f "$s" ]; then
      sum_script="$s"
      break
    fi
  done
  if [ -n "$sum_script" ]; then
    python3 "$sum_script" "$@"
  else
    echo "Error: summarize-context.py not found." >&2
    exit 1
  fi
}

cmd_watch() {
  echo -e "\033[1;36m👀 Watching LiteLLM Router traffic in real-time (Press Ctrl+C to exit)...\033[0m"
  docker logs -f free-llm-router 2>&1 | grep --line-buffered -E "ROUTER|POST"
}

case "${1:-status}" in
  status)
    cmd_status
    ;;
  models)
    cmd_models
    ;;
  test)
    cmd_test
    ;;
  last)
    cmd_last
    ;;
  watch)
    cmd_watch
    ;;
  auto-heal|heal)
    shift
    cmd_auto_heal "$@"
    ;;
  summarize|compact)
    shift
    cmd_summarize "$@"
    ;;
  router)
    shift
    cmd_router "$@"
    ;;
  opencode)
    shift
    if [ -n "$1" ]; then
      exec opencode --model "$1" "${@:2}"
    else
      exec opencode "$@"
    fi
    ;;
  standalone)
    shift
    echo -e "\033[1;36m🚀 Starting OpenCode in isolated --standalone mode (private daemon session)...\033[0m"
    exec opencode --standalone "$@"
    ;;
  help|--help|-h)
    cmd_status
    ;;
  *)
    echo "Unknown command: $1"
    echo "Usage: free-ai [status|models|test|last|watch|summarize|router|opencode]"
    exit 1
    ;;
esac

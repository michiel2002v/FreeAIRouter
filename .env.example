# ==============================================================================
# FreeAIRouter - Environment Variables Template
# ==============================================================================
# Copy this file to '.env' and fill in the API keys for the providers you wish to use.
# You DO NOT need every key — the router automatically skips providers with missing keys
# and load-balances across whichever keys are configured!
#
# Reference catalog for free LLM API providers:
# https://github.com/mnfst/awesome-free-llm-apis
# ==============================================================================

# 1. Mistral AI (Premier Coding & 256K FIM Codestral)
# Get free key at: https://console.mistral.ai/api-keys/
MISTRAL_API_KEY=your_mistral_api_key_here

# 2. Google Gemini AI Studio (1,000,000+ context reasoning: Gemini 3.8 Flash & 3.5 Flash-Lite)
# Get free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# 3. Groq Cloud (Ultra-fast LPU inference: GPT-OSS 120B, Qwen 27B)
# Get free key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# 4. OpenRouter (550B Nemotron Ultra, Cohere North Mini Code, Nemotron 3.5 Lightning, Free Router)
# Get free key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# 5. Cohere Platform (128K Command R+ Frontier Tool Model)
# Get free key at: https://dashboard.cohere.com/api-keys
COHERE_API_KEY=your_cohere_api_key_here

# 6. Cloudflare Workers AI (Llama 3.3 70B Fast FP8)
# Get token & account ID at: https://dash.cloudflare.com/
CF_API_TOKEN=your_cloudflare_api_token_here
CF_ACCOUNT_ID=your_cloudflare_account_id_here

# 7. Kilo Code (Reflection Beam & Community Free Coding Models)
# Get free key at: https://kilo.ai/
KILO_API_KEY=your_kilo_api_key_here

# 8. Gonka Broker (DeepSeek V4 Flash 400K Reasoning)
# Get free key at: https://gonkabroker.com/
GONKA_API_KEY=your_gonka_api_key_here

# 9. NVIDIA NIM (GPT-OSS 20B, Nemotron)
# Get free key at: https://build.nvidia.com/
NVIDIA_API_KEY=your_nvidia_api_key_here

# 10. Aion Labs (Aion 2.0 Reasoning)
# Get free key at: https://aionlabs.ai/
AION_API_KEY=your_aion_api_key_here

# 11. Zhipu AI / Z AI BigModel (GLM-4.7-Flash Series)
# Get free key at: https://open.bigmodel.cn/
ZAI_API_KEY=your_zhipu_api_key_here

# 12. Requesty Router (Pennytree Free Tier Policy Model)
# Get free key at: https://requesty.ai/
REQUESTY_API_KEY=your_requesty_api_key_here
